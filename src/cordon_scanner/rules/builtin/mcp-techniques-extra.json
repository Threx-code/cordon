  "requires": [
   "(?:\\bexec\\w{0,8}\\(|\\bspawn\\(|\\bsystem\\(|subprocess\\.\\w{1,12}\\([^\\n]{0,200}shell\\s*=\\s*True|os\\.popen\\(|exec\\.Command\\(\\s*\\\"(?:sh|bash|cmd|powershell)\\\"|Command::new\\(\\s*\\\"(?:sh|bash|cmd|powershell)\\\"\\)|new\\s+Function\\()"
  ],
  "unless": [
