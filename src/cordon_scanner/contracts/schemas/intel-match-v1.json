{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordonscan.com/schemas/intel-match-v1.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^R[1-9][0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^(pkg|ci|ext|skill|mcp|model|agent|repo|art):[^\\s]+$"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "confirmed"
      ]
    }
  },
  "title": "https://cordonscan.com/intel-match/v1: a known-malware or advisory match for a digest (spec 7.2)",
  "type": "object",
  "required": [
    "kind",
    "id",
    "source",
    "first_seen"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "known_malware",
        "advisory"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "first_seen": {
      "$ref": "#/$defs/timestamp"
    },
    "withdrawn": {
      "type": "boolean"
    },
    "url": {
      "type": "string"
    }
  }
}
