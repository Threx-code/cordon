{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordonscan.com/schemas/review-v1.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^R[1-9][0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^(pkg|ci|ext|skill|mcp|model|agent|repo|art):[^\\s]+$"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "confirmed"
      ]
    }
  },
  "title": "https://cordonscan.com/review/v1: a two-reader label of a unit (spec 7.2, self-improving loop)",
  "type": "object",
  "required": [
    "label",
    "readers",
    "reasoning"
  ],
  "additionalProperties": false,
  "properties": {
    "label": {
      "enum": [
        "malicious",
        "benign",
        "error",
        "hazard",
        "unsure"
      ]
    },
    "readers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "reader",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "reader": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "enum": [
              "malicious",
              "benign",
              "error",
              "hazard",
              "unsure"
            ]
          },
          "at": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
