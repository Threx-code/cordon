{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordonscan.com/schemas/approval-v1.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^R[1-9][0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^(pkg|ci|ext|skill|mcp|model|agent|repo|art):[^\\s]+$"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "confirmed"
      ]
    }
  },
  "title": "https://cordonscan.com/approval/v1: an approval bound to digests, with an expiry (spec 5.3 step 5)",
  "type": "object",
  "required": [
    "approver",
    "scope",
    "digests",
    "expires_at"
  ],
  "additionalProperties": false,
  "properties": {
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "outcome": {
      "description": "An exception's meaning, carried so the signature covers it: what the exception turns a finding into. Present for an exception, with rule_ids and reason_codes; absent for a plain approval.",
      "enum": [
        "REVIEW",
        "ALLOW"
      ]
    },
    "rule_ids": {
      "description": "The rules an exception speaks for; null is every rule. A list is never empty: an empty list would read as none and as all.",
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^\\s]+$"
      }
    },
    "reason_codes": {
      "description": "The reason codes an exception speaks for; null is every reason code. A list is never empty.",
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason_code"
      }
    }
  }
}
