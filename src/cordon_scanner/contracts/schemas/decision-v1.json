{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordonscan.com/schemas/decision-v1.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^R[1-9][0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^(pkg|ci|ext|skill|mcp|model|agent|repo|art):[^\\s]+$"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "confirmed"
      ]
    }
  },
  "title": "https://cordonscan.com/decision/v1: the outcome of decide() for one artifact in one context (spec 5.1)",
  "type": "object",
  "required": [
    "state",
    "reason_codes",
    "explanation",
    "obligations",
    "inputs_digest",
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "state": {
      "enum": [
        "ALLOW",
        "ALLOW_WITH_CONDITIONS",
        "REVIEW",
        "BLOCK"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason_code"
      }
    },
    "explanation": {
      "type": "object",
      "required": [
        "summary",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "$ref": "#/$defs/reason_code"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "rule_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "evidence_hash": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^O[0-9]{3}$"
      }
    },
    "inputs_digest": {
      "$ref": "#/$defs/digest"
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "point": {
          "enum": [
            "cli",
            "ide",
            "agent_hook",
            "firewall",
            "ci_gate",
            "deploy_admission",
            "inventory_sweep"
          ]
        },
        "environment": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "direct",
            "transitive",
            "bundled",
            "runtime",
            "tool"
          ]
        }
      }
    },
    "clock_bucket": {
      "$ref": "#/$defs/timestamp"
    },
    "relaxations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "setting",
          "level",
          "environment"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/$defs/reason_code"
          },
          "setting": {
            "enum": [
              "on_incomplete",
              "unresolved",
              "on_gaps"
            ]
          },
          "level": {
            "enum": [
              "warn",
              "review"
            ]
          },
          "environment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
