{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordonscan.com/schemas/inventory-v1.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^R[1-9][0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^(pkg|ci|ext|skill|mcp|model|agent|repo|art):[^\\s]+$"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "confirmed"
      ]
    }
  },
  "title": "https://cordonscan.com/inventory/v1: what is installed where (spec 7.2, 11)",
  "type": "object",
  "required": [
    "occurrences"
  ],
  "additionalProperties": false,
  "properties": {
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "digest",
          "where"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": {
            "$ref": "#/$defs/subject_id"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "version": {
            "type": "string"
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "direct",
              "transitive",
              "bundled",
              "runtime",
              "tool"
            ]
          }
        }
      }
    }
  }
}
