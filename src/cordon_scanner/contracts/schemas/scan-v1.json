{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordonscan.com/schemas/scan-v1.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^R[1-9][0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^(pkg|ci|ext|skill|mcp|model|agent|repo|art):[^\\s]+$"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "confirmed"
      ]
    }
  },
  "title": "https://cordonscan.com/scan/v1: what the scanner found in one artifact (spec 7.2)",
  "type": "object",
  "required": [
    "findings",
    "completeness"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "confidence",
          "category",
          "location"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_.]*[0-9A-Z]$"
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "category": {
            "enum": [
              "malicious",
              "suspicious",
              "vulnerable",
              "policy",
              "operational"
            ]
          },
          "location": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "evidence_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16,64}$"
          },
          "detector": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "required": [
        "complete"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "versions": {
      "type": "object",
      "properties": {
        "scanner": {
          "type": "string"
        },
        "rules": {
          "type": "string"
        }
      }
    }
  }
}
