.venv/
reviews
# Measurement output. `scripts/measure_noise.py` and the recall scripts write
# their JSON beside wherever they are run from, which is ordinarily this tree.
recall.json
noise-*.json
.iac-schema/

# Output of the measurement scripts, written where they are run.
