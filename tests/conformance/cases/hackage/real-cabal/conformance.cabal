cabal-version:      3.0
name:               conformance
version:            0.1.0.0
license:            MIT
build-type:         Simple

flag dev
  description: Development extras
  default:     False
  manual:      True

common shared
  build-depends:
      base >=4.17 && <5
    , text ^>=2.0

library
  import:           shared
  exposed-modules:  Conformance
  hs-source-dirs:   src
  build-depends:
      aeson >=2.1 && <2.3
    , containers
    , safe
  if os(windows)
    build-depends: Win32
  else
    build-depends: unix
  if flag(dev)
    build-depends: pretty-simple
  default-language: Haskell2010

executable conformance
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    conformance, optparse-applicative ^>=0.18
  default-language: Haskell2010

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    conformance, hspec >=2.10
  default-language: Haskell2010
