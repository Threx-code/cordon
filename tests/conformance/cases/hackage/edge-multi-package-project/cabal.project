-- Two packages built together, one freeze file for both.
packages:
  core/
  app/*.cabal

repository acme
  url: https://hackage.acme.example.internal/
  secure: True

active-repositories: hackage.haskell.org, acme:override

with-compiler: ghc-9.8.2

constraints:
  any.text ==2.1.1,
  zlib +pkg-config

package core
  flags: +fast

index-state: hackage.haskell.org 2024-06-01T00:00:00Z
