# Cordon, Syft and crane, for `image_agreement.py`. Syft is copied from its publisher's image at a
# pinned version; crane is the release binary, verified against the release's checksums file;
# Cordon is the benchmark image's.
FROM anchore/syft:v1.18.1 AS syft
FROM cordon-bench:dev
ARG CRANE_VERSION=0.20.2
RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) a=x86_64 ;; arm64) a=arm64 ;; *) echo "unsupported $arch"; exit 1 ;; esac; \
    cd /tmp; \
    curl -fsSLO "https://github.com/google/go-containerregistry/releases/download/v${CRANE_VERSION}/go-containerregistry_Linux_${a}.tar.gz"; \
    curl -fsSLO "https://github.com/google/go-containerregistry/releases/download/v${CRANE_VERSION}/checksums.txt"; \
    grep " go-containerregistry_Linux_${a}.tar.gz\$" checksums.txt | sha256sum -c -; \
    tar -xzf "go-containerregistry_Linux_${a}.tar.gz" -C /usr/local/bin crane; \
    rm -f /tmp/*
COPY --from=syft /syft /usr/local/bin/syft
COPY bench/image_agreement.py /bench/image_agreement.py
RUN mkdir -p /scratch
ENTRYPOINT ["python", "/bench/image_agreement.py"]
